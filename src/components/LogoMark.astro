---
/**
 * Знак «Кладка»: фрагмент огнеупорной кладки в перевязку, центральный кирпич — раскалённый.
 * Цвет кирпичей — currentColor (светлый на тёмном, графит на светлом), акцент фиксирован.
 */
interface Props { size?: number; title?: string; class?: string; }
const { size = 34, title = 'МинСтил', class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg" fill="currentColor">
  <rect x="4" y="6" width="26" height="15" rx="1.5" />
  <rect x="34" y="6" width="26" height="15" rx="1.5" />
  <rect x="4" y="25" width="11" height="15" rx="1.5" />
  <rect x="19" y="25" width="26" height="15" rx="1.5" fill="#C9581C" />
  <rect x="49" y="25" width="11" height="15" rx="1.5" />
  <rect x="4" y="44" width="26" height="15" rx="1.5" />
  <rect x="34" y="44" width="26" height="15" rx="1.5" />
</svg>
