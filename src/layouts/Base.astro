---
import { withBase } from '../lib/url';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const siteUrl = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ymId = import.meta.env.PUBLIC_YM_ID ? Number(import.meta.env.PUBLIC_YM_ID) : null;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  alternateName: site.name,
  url: new URL(withBase(), siteUrl).href,
  email: site.email,
  foundingDate: String(site.since),
  taxID: site.requisites.inn,
  identifier: { '@type': 'PropertyValue', propertyID: 'ОГРН', value: site.requisites.ogrn },
  telephone: site.phones.map((p) => p.display),
  address: { '@type': 'PostalAddress', addressCountry: 'RU', addressLocality: 'Санкт-Петербург', streetAddress: site.address },
};
---
<!doctype html>
<html lang="ru" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#161412" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase('og.png'), siteUrl).href} />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(org)} />
    {ymId && (
      <script is:inline define:vars={{ ymId }}>
        // Код счётчика — как выдала Метрика (без ecommerce: магазина на сайте нет)
        window.__YM_ID__ = ymId;
        (function (m, e, t, r, i, k, a) {
          m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
          m[i].l = 1 * new Date();
          for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
          k = e.createElement(t); a = e.getElementsByTagName(t)[0];
          k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
        })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=' + ymId, 'ym');
        ym(ymId, 'init', { ssr: true, webvisor: true, clickmap: true, referrer: document.referrer, url: location.href, accurateTrackBounce: true, trackLinks: true });
      </script>
    )}
  </head>
  <body>
    {ymId && <noscript><div><img src={`https://mc.yandex.ru/watch/${ymId}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>}
    <a class="sr-only" href="#main">К содержимому</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      import { initRequest } from '../scripts/request';
      import { trackContactClicks } from '../scripts/analytics';
      initRequest();
      trackContactClicks();
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
        { rootMargin: '0px 0px -6% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
